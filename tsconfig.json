{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		// The runtime (cli/, lint/, mcp/, scripts/) is TypeScript that Node
		// executes directly: the types are erased, never compiled away. Only
		// erasable syntax is allowed there, and type-only imports must say so.
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"types": [
			"node"
		]
	},
	// SvelteKit's own list, plus the repo's TypeScript scripts and the shipped
	// Node runtime sources (cli/, lint/, mcp/, scripts/) — all of which run on
	// Node's type stripping, not through a compile step.
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/env.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"scripts/**/*.ts",
		"cli/**/*.ts",
		"lint/**/*.ts",
		"mcp/**/*.ts"
	]
}
