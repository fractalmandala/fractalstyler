{
	"name": "@fractaldesign/fractalstyler",
	"version": "1.6.0",
	"license": "MIT",
	"description": "A lean CSS composition, styling, and design system designed for minimal classes, maximal customizability.",
	"homepage": "https://fractalsvelte.dev/fractalstyler",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fractalmandala/fractalstyler.git"
	},
	"bugs": {
		"url": "https://github.com/fractalmandala/fractalstyler/issues"
	},
	"author": "fractalmandala",
	"bin": {
		"fractalstyler": "cli/main.mjs",
		"fractalstyler-lint": "lint/cli.mjs",
		"fractalstyler-mcp": "mcp/server.mjs"
	},
	"scripts": {
		"registry": "node scripts/update-registry.ts",
		"tokens": "node scripts/build-tokens-registry.ts",
		"lint": "node lint/cli.ts",
		"browser": "node lint/browser.ts",
		"mcp": "node mcp/server.ts",
		"dev": "vite dev",
		"preview": "vite preview",
		"build": "npm run registry && npm run tokens && npm run prepack",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/validate-deck.ts && node lint/cli.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"validate:deck": "node scripts/validate-deck.ts",
		"version": "npm run registry && npm run tokens && git add -A"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"registry.json",
		"registry.md",
		"skills",
		"lint",
		"mcp",
		"cli",
		"runtime",
		"docs",
		"scripts"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./layout": {
			"types": "./dist/layout/index.d.ts",
			"svelte": "./dist/layout/index.js",
			"default": "./dist/layout/index.js"
		},
		"./styles": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/styles/index.css"
		},
		"./styles/*": "./dist/styles/*",
		"./registry.json": "./registry.json",
		"./registry.md": "./registry.md",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.0.0",
		"publint": "^0.3.21",
		"sass": "^1.102.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"keywords": [
		"css",
		"design-system",
		"styling",
		"svelte",
		"sveltekit",
		"utility-classes",
		"design-tokens",
		"fractal"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0"
	},
	"engines": {
		"node": ">=22.18"
	}
}
