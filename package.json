{
	"name": "@fractaldesign/fractalstyler",
	"version": "1.2.0",
	"license": "MIT",
	"description": "A composition styling system, shipped as plain CSS and as editable SASS. The class registry is the public API: compose in markup, write no stylesheet.",
	"bin": {
		"fractalstyler": "cli/main.mjs",
		"fractalstyler-lint": "lint/cli.mjs",
		"fractalstyler-mcp": "mcp/server.mjs"
	},
	"scripts": {
		"registry": "node scripts/update-registry.js && node scripts/class-vocab.js",
		"vocab": "node scripts/class-vocab.js",
		"lint": "node lint/cli.mjs",
		"browser": "node lint/browser.mjs",
		"mcp": "node mcp/server.mjs",
		"dev": "vite dev",
		"preview": "vite preview",
		"build": "npm run registry && npm run prepack",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "npm run registry && svelte-kit sync && svelte-package && npm run css && ([ -f lint/cli.mjs ] && chmod +x lint/cli.mjs || true) && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/validate-deck.js && node lint/cli.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"validate:deck": "node scripts/validate-deck.js",
		"css": "node scripts/build-css.js",
		"version": "npm run registry && git add -A",
		"pair": "node scripts/generate-pairs.mjs && node scripts/update-registry.js"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"registry.json",
		"skills",
		"lint",
		"mcp",
		"data",
		"cli",
		"docs/REGISTRY.api.md",
		"docs/references",
		"scripts/update-registry.js",
		"scripts/class-vocab.js"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/styles/index.sass"
		},
		"./styles/*": "./dist/styles/*",
		"./tokens": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/styles/_00_tokens.sass"
		},
		"./css": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/css/fractalstyler.css"
		},
		"./css/min": {
			"types": "./dist/asset.d.ts",
			"default": "./dist/css/fractalstyler.min.css"
		},
		"./recipes": "./data/recipes.json",
		"./presets": {
			"types": "./dist/presets.svelte.d.ts",
			"svelte": "./dist/presets.svelte.js",
			"default": "./dist/presets.svelte.js"
		},
		"./PresetControls": {
			"types": "./dist/ui/PresetControls.svelte.d.ts",
			"svelte": "./dist/ui/PresetControls.svelte",
			"default": "./dist/ui/PresetControls.svelte"
		},
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"sass": "^1.102.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"publint": "^0.3.21",
		"sass": "^1.102.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"keywords": [
		"css",
		"sass",
		"design-system",
		"styling",
		"svelte",
		"sveltekit",
		"utility-classes",
		"design-tokens",
		"fractal"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0"
	},
	"engines": {
		"node": ">=18"
	},
	"peerDependenciesMeta": {
		"sass": {
			"optional": true
		}
	}
}
